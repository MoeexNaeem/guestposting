# --- Dependencies ---
# Never upload node_modules as they are huge and can be reinstalled with 'npm install'
node_modules/
jspm_packages/

# --- Environment Variables ---
# CRITICAL: These contain your MongoDB password and Email secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Build & Output ---
# Exclude the production folders generated by Netlify or build scripts
dist/
build/
out/
.next/

# --- Logs & Debugging ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# --- IDE & Editor Files ---
# Files created by VS Code, IntelliJ, etc.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Junk ---
# System files like Mac's thumbnail cache
.DS_Store
Thumbs.db

# --- Miscellaneous ---
# If you use Multer for file uploads, exclude the temporary upload folder
uploads/